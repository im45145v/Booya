{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DemoLens",
  "version": "0.1.1",
  "identifier": "dev.demolens.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "DemoLens", "width": 1360, "height": 860, "minWidth": 1000, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "license": "MIT",
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" }
  }
}
