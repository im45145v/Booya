{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DemoLens",
  "version": "0.5.1",
  "identifier": "dev.demolens.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DemoLens",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'",
        "media-src": "'self' asset: http://asset.localhost blob:"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPCACHE/proxies/**",
          "$CACHE/**",
          "$VIDEO/DemoLens/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "license": "MIT",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.3",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBOTEyQ0VDQjVCQTg0OUIKUldTYmhMcTE3Q3lSaWxGdmVqQ3lxWEZJS050Nm1TYUNxZ09mN2svREZIRVFRWWMyOWQzY2NrdFMK",
      "endpoints": [
        "https://github.com/im45145v/DemoLens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
