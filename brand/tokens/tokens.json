{
  "$description": "Booya design tokens. Direction E, Ghost x Ink mono. Values in px unless stated.",
  "color": {
    "palette": {
      "light": {
        "paper": "#F4F3EF",
        "surface": "#FFFFFF",
        "ink": "#111110",
        "graphite": "#6B6963",
        "rule": "#DCDAD3",
        "signal": "#FF5A1F"
      },
      "dark": {
        "night": "#111110",
        "surface": "#1C1B19",
        "paper": "#EDEBE5",
        "stone": "#8D8A82",
        "rule": "#2C2B28",
        "signal": "#FF6A33"
      }
    },
    "semantic": {
      "light": {
        "bg": "#F4F3EF",
        "surface": "#FFFFFF",
        "surface-raised": "#FFFFFF",
        "text": "#111110",
        "text-muted": "#6B6963",
        "rule": "#DCDAD3",
        "border-strong": "#8C8A83",
        "signal": "#FF5A1F",
        "signal-text": "#BF4317",
        "on-signal": "#111110",
        "success": "#1D7A45",
        "warning": "#975A00",
        "danger": "#C2301F",
        "recording": "#FF5A1F",
        "focus": "#111110",
        "inverse": "#111110",
        "on-inverse": "#F4F3EF",
        "overlay-caption-bg": "rgba(17,17,16,0.82)",
        "overlay-caption-text": "#F4F3EF"
      },
      "dark": {
        "bg": "#111110",
        "surface": "#1C1B19",
        "surface-raised": "#24231F",
        "text": "#EDEBE5",
        "text-muted": "#8D8A82",
        "rule": "#2C2B28",
        "border-strong": "#76736C",
        "signal": "#FF6A33",
        "signal-text": "#FF6A33",
        "on-signal": "#111110",
        "success": "#4CC385",
        "warning": "#F0B24E",
        "danger": "#FF6B5B",
        "recording": "#FF6A33",
        "focus": "#EDEBE5",
        "inverse": "#EDEBE5",
        "on-inverse": "#111110",
        "overlay-caption-bg": "rgba(17,17,16,0.82)",
        "overlay-caption-text": "#F4F3EF"
      }
    }
  },
  "font": {
    "family": {
      "sans": "'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "'Geist Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
      "wordmark": "Geist SemiBold (600), tracking -0.035em, outlined in logo files"
    },
    "scale": {
      "display": {
        "size": 56,
        "line": 60,
        "weight": 600,
        "tracking": "-0.03em"
      },
      "h1": {
        "size": 40,
        "line": 44,
        "weight": 600,
        "tracking": "-0.025em"
      },
      "h2": {
        "size": 28,
        "line": 34,
        "weight": 600,
        "tracking": "-0.02em"
      },
      "h3": {
        "size": 20,
        "line": 28,
        "weight": 600,
        "tracking": "-0.01em"
      },
      "body": {
        "size": 15,
        "line": 24,
        "weight": 400,
        "tracking": "0"
      },
      "body-strong": {
        "size": 15,
        "line": 24,
        "weight": 550,
        "tracking": "0"
      },
      "small": {
        "size": 13,
        "line": 20,
        "weight": 400,
        "tracking": "0"
      },
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 500,
        "tracking": "0.01em"
      },
      "overline": {
        "size": 11,
        "line": 14,
        "weight": 500,
        "tracking": "0.08em",
        "family": "mono",
        "transform": "uppercase"
      },
      "timer": {
        "size": 15,
        "line": 20,
        "weight": 500,
        "tracking": "0",
        "family": "mono",
        "numeric": "tabular-nums"
      },
      "caption-overlay": {
        "size": 22,
        "line": 30,
        "weight": 500,
        "tracking": "-0.005em"
      }
    }
  },
  "space": {
    "0": "0px",
    "0.5": "2px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "999px"
  },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(17,17,16,0.08)",
      "md": "0 1px 2px rgba(17,17,16,0.06), 0 8px 24px rgba(17,17,16,0.10)",
      "lg": "0 2px 4px rgba(17,17,16,0.06), 0 18px 48px rgba(17,17,16,0.16)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0,0,0,0.4)",
      "md": "0 1px 2px rgba(0,0,0,0.4), 0 8px 24px rgba(0,0,0,0.45)",
      "lg": "0 2px 4px rgba(0,0,0,0.4), 0 18px 48px rgba(0,0,0,0.55)"
    }
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "blink": "120ms",
      "fast": "150ms",
      "base": "200ms",
      "ripple": "400ms",
      "trail": "240ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "linear": "linear"
    },
    "ripple": {
      "scale_from": 0.4,
      "scale_to": 1.6,
      "opacity_from": 0.6,
      "opacity_to": 0,
      "rings": 1
    },
    "blink": {
      "scale_y": 0.1,
      "when": "record start and record stop only"
    }
  },
  "usage": {
    "signal_max_share_of_screen": "10%",
    "recording_state_color": "signal",
    "min_text_contrast": "4.5:1"
  }
}